<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="SendGridEmailDemo.SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> - SendGrid Email Demo</title>

    <%-- Google Fonts --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <%-- Bootstrap 5 CSS --%>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YcnS/1t0dCmkaQP3UgIph/7FbO3Bs3SwggfN"
          crossorigin="anonymous" />

    <%-- Bootstrap Icons --%>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <%-- Site Theme --%>
    <link href="Content/Site.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">

        <%-- ============ NAVBAR ============ --%>
        <nav class="navbar navbar-expand-lg navbar-dark site-navbar">
            <div class="container">
                <a class="navbar-brand" href="Default.aspx">
                    <span class="brand-icon">
                        <i class="bi bi-envelope-paper-fill"></i>
                    </span>
                    <span class="brand-text">
                        SendGrid<span class="brand-accent">Demo</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link <%= GetActiveClass("Default.aspx") %>" href="Default.aspx">
                                <i class="bi bi-pencil-square me-1"></i> Compose
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= GetActiveClass("SendMail.aspx") %>" href="SendMail.aspx">
                                <i class="bi bi-send-plus me-1"></i> Send Mail
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= GetActiveClass("About.aspx") %>" href="About.aspx">
                                <i class="bi bi-book me-1"></i> Guide
                            </a>
                        </li>
                    </ul>
                    <div class="navbar-badge d-none d-lg-flex">
                        <i class="bi bi-shield-check me-1"></i>
                        <span>Powered by Twilio SendGrid</span>
                    </div>
                </div>
            </div>
        </nav>

        <%-- ============ MAIN CONTENT ============ --%>
        <main class="site-main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <%-- ============ FOOTER ============ --%>
        <footer class="site-footer">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-start">
                        <span class="footer-brand">
                            <i class="bi bi-envelope-paper-fill me-1"></i> SendGridDemo
                        </span>
                        <span class="footer-copy">&copy; <%= DateTime.Now.Year %> &mdash; ASP.NET Web Forms Demo</span>
                    </div>
                    <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                        <a href="https://sendgrid.com/docs/" class="footer-link" target="_blank" rel="noopener">
                            <i class="bi bi-box-arrow-up-right me-1"></i>SendGrid Docs
                        </a>
                        <a href="https://github.com/sendgrid/sendgrid-csharp" class="footer-link" target="_blank" rel="noopener">
                            <i class="bi bi-github me-1"></i>C# SDK
                        </a>
                    </div>
                </div>
            </div>
        </footer>

        <%-- Loading Overlay (shown during postback) --%>
        <div id="loadingOverlay" class="loading-overlay" style="display: none;">
            <div class="loading-spinner">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Sending...</span>
                </div>
                <p class="text-light mt-3 fw-500">Sending your email...</p>
            </div>
        </div>

    </form>

    <%-- Bootstrap 5 JS Bundle --%>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    <%-- Show loading overlay on form submit --%>
    <script>
        (function () {
            var form = document.getElementById('form1');
            if (form) {
                form.addEventListener('submit', function () {
                    if (typeof Page_IsValid !== 'undefined' && !Page_IsValid) {
                        return;
                    }
                    document.getElementById('loadingOverlay').style.display = 'flex';
                });
            }
        })();
    </script>

    <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
